{
  "name": "there-will-be-dungeons-documentation-checks",
  "private": true,
  "version": "0.0.0",
  "description": "Repository-local documentation validation tools",
  "scripts": {
    "check:illustrations": "python tools/validate_illustration_references.py",
    "lint:markdown": "node scripts/lint-markdown.mjs",
    "lint:markdown:fix": "node scripts/lint-markdown.mjs --fix",
    "lint:python": "python -m ruff check .",
    "typecheck:python": "python -m pyright",
    "check:python": "npm run lint:python && npm run typecheck:python"
  },
  "devDependencies": {
    "markdownlint": "0.42.0"
  },
  "overrides": {
    "katex": "0.18.2",
    "re2js": "2.8.7"
  }
}
